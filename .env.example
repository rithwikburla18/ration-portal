# Copy required values into your local shell or deployment environment.
# Never commit real credentials, passwords, JWT keys, or provider API keys.

# Required database settings. Use a dedicated Neon development branch for local testing.
DB_URL=jdbc:postgresql://your-neon-host/your-database?sslmode=require
DB_USERNAME=your-neon-username
DB_PASSWORD=replace-with-database-password

# Required: a random, private signing key. At least 32 random bytes is recommended.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# Admin bootstrap is optional. Configure only in the intended environment.
# When configured, the app ensures this account has ADMIN role and ACTIVE status.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Email and SMS notifications use Brevo's API.
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_FROM_EMAIL=verified-sender@example.com
BREVO_SMS_SENDER=RationPortal
FRONTEND_URL=http://localhost:5500

# Public API URL put into QR codes and frontend links.
APP_PUBLIC_API_BASE_URL=http://localhost:8080

# Comma-separated exact origins; do not use a wildcard with credentials.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional business configuration.
RATION_RICE_KG_PER_MEMBER=6
RATION_DISTRIBUTION_START_DAY=1
RATION_DISTRIBUTION_END_DAY=15
RATION_OTP_COOLDOWN_SECONDS=60
RATION_IMPORT_MAX_FILE_BYTES=5242880

# Optional legacy SMTP settings. Current email flows use Brevo settings above.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
